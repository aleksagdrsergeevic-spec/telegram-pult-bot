# Токен бота от @BotFather. Обязателен.
TELEGRAM_BOT_TOKEN=

# Кому разрешено управлять ботом: chat id через запятую (например 123456789,-1001234567890).
# Пусто = бот отвечает отказом всем.
ALLOWED_CHAT_IDS=

# Модель OpenCode в формате provider/model.
# opencode/big-pickle — Big Pickle, бесплатная модель OpenCode Zen.
MODEL=opencode/big-pickle

# Где лежат рабочие папки сессий. Всё строго внутри этого каталога.
WORKSPACES_DIR=/var/lib/telegram-pult/workspaces

# Файл с текущей сессией и id сессий OpenCode.
SESSIONS_FILE=/var/lib/telegram-pult/sessions.json

# Лог-файл и ротация по размеру (байты) с сохранением LOG_MAX_FILES архивов.
LOG_FILE=/var/lib/telegram-pult/logs/pult.log
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=3

# Ограничения
PROMPT_MAX_LENGTH=4000
TASK_TIMEOUT_MS=1200000
EDIT_INTERVAL_MS=1200
STREAM_WINDOW=3600
POLL_TIMEOUT=25
GIT_CLONE_TIMEOUT_MS=180000

# Бинарники (обычно менять не нужно)
OPENCODE_BIN=opencode
GIT_BIN=git

# Для отладки: можно указать другой адрес Telegram API (например локальный прокси)
TELEGRAM_API_BASE=https://api.telegram.org
